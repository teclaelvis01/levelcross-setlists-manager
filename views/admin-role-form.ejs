<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const isEdit = !!(role && role.id);
  const errors = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  const formName = role && role.name ? role.name : '';
  const formCategory = role && role.category ? role.category : 'Otros';
  const categories = typeof roleCategories !== 'undefined' && Array.isArray(roleCategories) && roleCategories.length
    ? roleCategories
    : ['Músicos', 'Cantantes', 'Sonido', 'Otros'];
  const allCategories = categories.includes(formCategory)
    ? categories
    : categories.concat(formCategory);
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1><%= isEdit ? 'Editar rol' : 'Nuevo rol' %></h1>
    <p class="page-subtitle">Define un rol musical disponible para personas y actividades</p>
  </div>
  <a href="<%= base %>/admin/ajustes" class="btn btn-secondary">← Volver</a>
</div>

<%- include('partials/admin-nav', { adminSection: 'settings' }) %>

<div class="section-card">
  <form
    action="<%= base %><%= isEdit ? '/admin/ajustes/roles/' + role.id : '/admin/ajustes/roles' %>"
    method="POST"
    class="song-form"
  >
    <div class="form-group<%= errors.name ? ' is-invalid' : '' %>">
      <label for="name">Nombre del rol *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        value="<%= formName %>"
        placeholder="Ej: Teclado"
        maxlength="80"
        aria-invalid="<%= errors.name ? 'true' : 'false' %>"
      >
      <% if (errors.name) { %><p class="field-error">Revisa el nombre del rol</p><% } %>
    </div>

    <div class="form-group" data-category-picker>
      <label>Tipo *</label>
      <div class="chip-selector chip-selector--single" data-category-chips>
        <% allCategories.forEach((item) => { %>
          <label class="chip-option">
            <input
              type="radio"
              name="category"
              value="<%= item %>"
              <%= formCategory === item ? 'checked' : '' %>
              required
            >
            <span><%= item %></span>
          </label>
        <% }) %>
      </div>
      <div class="category-tag-add">
        <input
          type="text"
          data-category-new
          maxlength="40"
          placeholder="Nuevo tipo…"
          autocomplete="off"
        >
        <button type="button" class="btn btn-secondary btn-sm" data-category-add>Añadir</button>
      </div>
      <p class="help-text">Elige un tipo o crea uno nuevo. Solo puede haber uno por rol.</p>
    </div>

    <div class="form-actions">
      <a href="<%= base %>/admin/ajustes" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary"><%= isEdit ? '💾 Guardar' : '✅ Crear' %></button>
    </div>
  </form>
</div>

<% if (isEdit) { %>
  <section class="danger-zone">
    <h2>Zona de peligro</h2>
    <p>Al eliminar este rol se quitará de todas las personas y actividades donde esté asignado. Esta acción no se puede deshacer.</p>
    <form
      action="<%= base %>/admin/ajustes/roles/<%= role.id %>/delete"
      method="POST"
      data-confirm-delete
      data-confirm-name="<%= role.name %>"
      data-confirm-title="Eliminar rol"
      data-confirm-message="Al eliminar este rol se quitará de todas las personas y actividades donde esté asignado. Esta acción no se puede deshacer."
      data-confirm-submit-label="Eliminar rol"
    >
      <button type="submit" class="btn btn-danger">Eliminar rol</button>
    </form>
  </section>
  <script src="<%= base %>/confirm-delete.js"></script>
<% } %>

<script>
  (function () {
    var root = document.querySelector('[data-category-picker]');
    if (!root) return;

    var chips = root.querySelector('[data-category-chips]');
    var input = root.querySelector('[data-category-new]');
    var addBtn = root.querySelector('[data-category-add]');
    if (!chips || !input || !addBtn) return;

    function normalize(value) {
      return String(value || '').trim().replace(/\s+/g, ' ').slice(0, 40);
    }

    function findChip(value) {
      var radios = chips.querySelectorAll('input[type="radio"][name="category"]');
      for (var i = 0; i < radios.length; i += 1) {
        if (radios[i].value.toLowerCase() === value.toLowerCase()) return radios[i];
      }
      return null;
    }

    function addCategory() {
      var value = normalize(input.value);
      if (!value) {
        input.focus();
        return;
      }

      var existing = findChip(value);
      if (existing) {
        existing.checked = true;
        input.value = '';
        input.focus();
        return;
      }

      var label = document.createElement('label');
      label.className = 'chip-option';
      label.innerHTML =
        '<input type="radio" name="category" value="" required>' +
        '<span></span>';
      var radio = label.querySelector('input');
      var span = label.querySelector('span');
      radio.value = value;
      radio.checked = true;
      span.textContent = value;
      chips.appendChild(label);
      input.value = '';
      input.focus();
    }

    addBtn.addEventListener('click', addCategory);
    input.addEventListener('keydown', function (event) {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      addCategory();
    });
  })();
</script>

<%- include('partials/foot') %>
