<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const isEdit = !!(activity && activity.id);
  const errors = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  const deleteConfirm = isEdit
    ? '¿Eliminar la actividad «' + activity.name + '»? Se borrará de forma permanente y no se puede deshacer.'
    : '';
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1><%= isEdit ? 'Editar actividad' : 'Nueva actividad' %></h1>
    <p class="page-subtitle">Define la actividad, las canciones y las personas responsables</p>
  </div>
  <div class="header-actions">
    <% if (isEdit && activity.slug) { %>
      <a href="<%= base %>/actividades/<%= activity.slug %>" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">Ver vista pública</a>
    <% } %>
    <a href="<%= base %>/admin/actividades" class="btn btn-secondary">← Volver</a>
  </div>
</div>

<%- include('partials/admin-nav', { adminSection: 'activities' }) %>

<form action="<%= base %><%= isEdit ? '/admin/actividades/' + activity.id : '/admin/actividades' %>" method="POST" class="song-form">
  <div class="section-card">
    <div class="form-group<%= errors.name ? ' is-invalid' : '' %>">
      <label for="name">Nombre de la actividad *</label>
      <input type="text" id="name" name="name" required value="<%= activity ? activity.name : '' %>" placeholder="Ej: Reunión de oración" aria-invalid="<%= errors.name ? 'true' : 'false' %>">
      <% if (errors.name) { %><p class="field-error">El nombre es obligatorio</p><% } %>
    </div>

    <div class="form-group<%= errors.activity_date ? ' is-invalid' : '' %>">
      <label for="activity_date">Fecha *</label>
      <input type="date" id="activity_date" name="activity_date" required value="<%= activity ? activity.activity_date : '' %>" aria-invalid="<%= errors.activity_date ? 'true' : 'false' %>">
      <% if (errors.activity_date) { %><p class="field-error">La fecha es obligatoria</p><% } %>
    </div>

    <div class="form-group">
      <label for="activity_time">Hora</label>
      <input type="time" id="activity_time" name="activity_time" value="<%= activity ? activity.activity_time : '' %>">
    </div>

    <div class="form-group">
      <label for="detail">Detalle</label>
      <textarea id="detail" name="detail" rows="4" placeholder="Información adicional, objetivo, tipo de culto, etc."><%= activity ? activity.detail : '' %></textarea>
    </div>
  </div>

  <div class="section-card">
    <h2>👥 Personas asignadas</h2>
    <p class="help-text">Marca a la persona y elige qué roles cumplirá en esta actividad.</p>
    <% if (!people || people.length === 0) { %>
      <div class="empty-state compact">
        <p>No hay personas creadas. Crea personas primero desde el panel de admin.</p>
      </div>
    <% } else { %>
      <div class="people-assign-grid">
        <% const selectedPeople = typeof assignedPeople !== 'undefined' && assignedPeople ? assignedPeople : []; %>
        <% people.forEach(person => {
          const assigned = selectedPeople.find(p => p.id === person.id);
          const selected = !!assigned;
          const availableRoles = person.roles || [];
          const selectedRoles = assigned
            ? (assigned.activityRoles && assigned.activityRoles.length ? assigned.activityRoles : availableRoles)
            : [];
          const initial = (person.name || 'P').charAt(0).toUpperCase();
        %>
          <div class="person-assign-card<%= selected ? ' is-selected' : '' %>" data-person-card>
            <label class="person-assign-card__main">
              <input
                type="checkbox"
                class="picker-checkbox"
                name="person_ids"
                value="<%= person.id %>"
                <%= selected ? 'checked' : '' %>
                data-person-toggle
              >
              <% if (person.photo_url) { %>
                <img src="<%= photoSrc(person.photo_url) %>" alt="" class="person-assign-card__photo" referrerpolicy="no-referrer">
              <% } else { %>
                <span class="person-assign-card__photo person-assign-card__photo--fallback" aria-hidden="true"><%= initial %></span>
              <% } %>
              <span class="song-picker-title"><%= person.name %></span>
            </label>

            <% if (availableRoles.length > 0) { %>
              <div class="chip-selector person-assign-card__roles" data-person-roles>
                <% availableRoles.forEach(role => {
                  const roleChecked = selected && selectedRoles.includes(role);
                %>
                  <label class="chip-option" data-role-chip>
                    <input
                      type="checkbox"
                      name="person_roles[<%= person.id %>][]"
                      value="<%= role %>"
                      <%= roleChecked ? 'checked' : '' %>
                      <%= selected ? '' : 'disabled' %>
                      data-person-role
                    >
                    <span><%= role %></span>
                  </label>
                <% }) %>
              </div>
            <% } else { %>
              <p class="help-text">Esta persona no tiene roles configurados.</p>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="section-card">
    <h2>🎵 Canciones en orden</h2>
    <% if (!songs || songs.length === 0) { %>
      <div class="empty-state compact">
        <p>No hay canciones creadas aún.</p>
      </div>
    <% } else {
      const selectedSongs = typeof assignedSongs !== 'undefined' && assignedSongs ? assignedSongs : [];
      const orderedSelected = selectedSongs
        .slice()
        .sort((a, b) => (a.position || 0) - (b.position || 0));
      const selectedIds = orderedSelected.map((song) => song.id);
    %>
      <p class="help-text">Añade canciones desde la biblioteca. Arrastra para cambiar el orden del setlist.</p>

      <div class="setlist-builder" data-setlist-builder>
        <div class="setlist-ordered-wrap">
          <div class="setlist-ordered-head">
            <strong>Setlist</strong>
            <span class="setlist-ordered-count" data-setlist-count><%= orderedSelected.length %></span>
          </div>
          <ol class="setlist-ordered" data-setlist-ordered>
            <% if (orderedSelected.length === 0) { %>
              <li class="setlist-empty" data-setlist-empty>Todavía no hay canciones. Elige alguna abajo.</li>
            <% } %>
            <% orderedSelected.forEach((song, index) => { %>
              <li class="setlist-item" draggable="true" data-setlist-item data-song-id="<%= song.id %>">
                <span class="setlist-item__handle" aria-hidden="true" title="Arrastrar">⋮⋮</span>
                <span class="setlist-item__order" data-order-badge><%= index + 1 %></span>
                <div class="setlist-item__info">
                  <strong><%= song.title %></strong>
                  <% if (song.artist) { %><small><%= song.artist %></small><% } %>
                </div>
                <button type="button" class="setlist-item__remove" data-song-remove aria-label="Quitar <%= song.title %>">×</button>
                <input type="hidden" name="song_ids" value="<%= song.id %>">
                <input type="hidden" name="song_order[<%= song.id %>]" value="<%= index + 1 %>" data-song-order>
              </li>
            <% }) %>
          </ol>
        </div>

        <div class="setlist-library-wrap">
          <div class="setlist-ordered-head">
            <strong>Biblioteca</strong>
            <span class="help-text" style="margin:0">Clic para añadir</span>
          </div>
          <div class="setlist-library" data-setlist-library>
            <% songs.forEach((song) => {
              if (selectedIds.includes(song.id)) return;
            %>
              <button
                type="button"
                class="setlist-pool-item"
                data-song-add
                data-song-id="<%= song.id %>"
                data-song-title="<%= song.title %>"
                data-song-artist="<%= song.artist || '' %>"
              >
                <span class="setlist-pool-item__title"><%= song.title %></span>
                <% if (song.artist) { %>
                  <small class="setlist-pool-item__artist"><%= song.artist %></small>
                <% } %>
                <span class="setlist-pool-item__add" aria-hidden="true">+</span>
              </button>
            <% }) %>
          </div>
        </div>
      </div>

      <template data-setlist-item-template>
        <li class="setlist-item" draggable="true" data-setlist-item>
          <span class="setlist-item__handle" aria-hidden="true" title="Arrastrar">⋮⋮</span>
          <span class="setlist-item__order" data-order-badge>1</span>
          <div class="setlist-item__info">
            <strong data-title></strong>
            <small data-artist hidden></small>
          </div>
          <button type="button" class="setlist-item__remove" data-song-remove aria-label="Quitar">×</button>
          <input type="hidden" name="song_ids" value="" data-input-id>
          <input type="hidden" name="" value="1" data-song-order data-input-order>
        </li>
      </template>

      <template data-setlist-pool-template>
        <button type="button" class="setlist-pool-item" data-song-add>
          <span class="setlist-pool-item__title" data-title></span>
          <small class="setlist-pool-item__artist" data-artist hidden></small>
          <span class="setlist-pool-item__add" aria-hidden="true">+</span>
        </button>
      </template>
    <% } %>
  </div>

  <div class="form-actions">
    <a href="<%= base %>/admin/actividades" class="btn btn-secondary">Cancelar</a>
    <button type="submit" class="btn btn-primary"><%= isEdit ? '💾 Guardar' : '✅ Crear' %></button>
  </div>
</form>

<% if (isEdit) { %>
  <section class="danger-zone">
    <h2>Zona de peligro</h2>
    <p>La actividad se eliminará de forma permanente, junto con sus canciones y personas asignadas. Esta acción no se puede deshacer.</p>
    <form action="<%= base %>/admin/actividades/<%= activity.id %>/delete" method="POST" onsubmit="return confirm(<%= JSON.stringify(deleteConfirm) %>)">
      <button type="submit" class="btn btn-danger">Eliminar actividad</button>
    </form>
  </section>
<% } %>

<script>
  (function initSetlistBuilder() {
    const builder = document.querySelector('[data-setlist-builder]');
    if (!builder) return;

    const orderedList = builder.querySelector('[data-setlist-ordered]');
    const library = builder.querySelector('[data-setlist-library]');
    const countEl = builder.querySelector('[data-setlist-count]');
    const itemTemplate = document.querySelector('[data-setlist-item-template]');
    const poolTemplate = document.querySelector('[data-setlist-pool-template]');
    if (!orderedList || !library || !itemTemplate || !poolTemplate) return;

    let dragItem = null;

    function getItems() {
      return Array.from(orderedList.querySelectorAll('[data-setlist-item]'));
    }

    function ensureEmptyState() {
      const empty = orderedList.querySelector('[data-setlist-empty]');
      const items = getItems();
      if (items.length === 0 && !empty) {
        const li = document.createElement('li');
        li.className = 'setlist-empty';
        li.dataset.setlistEmpty = '';
        li.textContent = 'Todavía no hay canciones. Elige alguna abajo.';
        orderedList.appendChild(li);
      }
      if (items.length > 0 && empty) empty.remove();
      if (countEl) countEl.textContent = String(items.length);
    }

    function renumber() {
      getItems().forEach((item, index) => {
        const order = index + 1;
        const badge = item.querySelector('[data-order-badge]');
        const orderInput = item.querySelector('[data-song-order]');
        if (badge) badge.textContent = String(order);
        if (orderInput) orderInput.value = String(order);
      });
      ensureEmptyState();
    }

    function createOrderedItem(songId, title, artist) {
      const node = itemTemplate.content.firstElementChild.cloneNode(true);
      node.dataset.songId = String(songId);
      node.querySelector('[data-title]').textContent = title;
      const artistEl = node.querySelector('[data-artist]');
      if (artist) {
        artistEl.textContent = artist;
        artistEl.hidden = false;
      } else {
        artistEl.hidden = true;
        artistEl.textContent = '';
      }
      node.querySelector('[data-song-remove]').setAttribute('aria-label', 'Quitar ' + title);
      node.querySelector('[data-input-id]').value = String(songId);
      const orderInput = node.querySelector('[data-input-order]');
      orderInput.name = 'song_order[' + songId + ']';
      orderInput.value = '1';
      return node;
    }

    function createPoolItem(songId, title, artist) {
      const node = poolTemplate.content.firstElementChild.cloneNode(true);
      node.dataset.songId = String(songId);
      node.dataset.songTitle = title;
      node.dataset.songArtist = artist || '';
      node.querySelector('[data-title]').textContent = title;
      const artistEl = node.querySelector('[data-artist]');
      if (artist) {
        artistEl.textContent = artist;
        artistEl.hidden = false;
      } else {
        artistEl.hidden = true;
        artistEl.textContent = '';
      }
      return node;
    }

    function addSong(songId, title, artist, poolButton) {
      if (orderedList.querySelector('[data-song-id="' + songId + '"]')) return;
      const item = createOrderedItem(songId, title, artist);
      orderedList.appendChild(item);
      if (poolButton) poolButton.remove();
      bindItem(item);
      renumber();
    }

    function removeSong(item) {
      const songId = item.dataset.songId;
      const titleEl = item.querySelector('.setlist-item__info strong');
      const artistEl = item.querySelector('.setlist-item__info small');
      const titleText = titleEl ? titleEl.textContent.trim() : '';
      const artistText = artistEl && !artistEl.hidden && artistEl.textContent.trim()
        ? artistEl.textContent.trim()
        : '';
      item.remove();
      library.appendChild(createPoolItem(songId, titleText, artistText));
      renumber();
    }

    function bindItem(item) {
      item.addEventListener('dragstart', (event) => {
        dragItem = item;
        item.classList.add('is-dragging');
        if (event.dataTransfer) {
          event.dataTransfer.effectAllowed = 'move';
          event.dataTransfer.setData('text/plain', item.dataset.songId || '');
        }
      });

      item.addEventListener('dragend', () => {
        item.classList.remove('is-dragging');
        orderedList.querySelectorAll('.is-drag-over').forEach((el) => el.classList.remove('is-drag-over'));
        dragItem = null;
        renumber();
      });

      item.addEventListener('dragover', (event) => {
        event.preventDefault();
        if (!dragItem || dragItem === item) return;
        const rect = item.getBoundingClientRect();
        const before = event.clientY < rect.top + rect.height / 2;
        orderedList.querySelectorAll('.is-drag-over').forEach((el) => el.classList.remove('is-drag-over'));
        item.classList.add('is-drag-over');
        if (before) orderedList.insertBefore(dragItem, item);
        else orderedList.insertBefore(dragItem, item.nextSibling);
      });

      const removeBtn = item.querySelector('[data-song-remove]');
      if (removeBtn) {
        removeBtn.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          removeSong(item);
        });
      }
    }

    library.addEventListener('click', (event) => {
      const button = event.target.closest('[data-song-add]');
      if (!button || !library.contains(button)) return;
      addSong(
        button.dataset.songId,
        button.dataset.songTitle || button.querySelector('.setlist-pool-item__title')?.textContent || '',
        button.dataset.songArtist || '',
        button
      );
    });

    orderedList.addEventListener('dragover', (event) => {
      event.preventDefault();
    });

    getItems().forEach(bindItem);
    ensureEmptyState();
  })();

  document.querySelectorAll('[data-person-toggle]').forEach((checkbox) => {
    const card = checkbox.closest('.person-assign-card');
    if (!card) return;
    const roleInputs = card.querySelectorAll('[data-person-role]');

    const sync = () => {
      const checked = checkbox.checked;
      card.classList.toggle('is-selected', checked);
      roleInputs.forEach((roleInput) => {
        roleInput.disabled = !checked;
        if (checked && !card.dataset.rolesTouched) {
          roleInput.checked = true;
        }
        if (!checked) {
          roleInput.checked = false;
          delete card.dataset.rolesTouched;
        }
      });
    };

    const togglePerson = () => {
      checkbox.checked = !checkbox.checked;
      checkbox.dispatchEvent(new Event('change', { bubbles: true }));
    };

    roleInputs.forEach((roleInput) => {
      roleInput.addEventListener('change', () => {
        card.dataset.rolesTouched = '1';
        if (roleInput.checked && !checkbox.checked) {
          checkbox.checked = true;
          sync();
        }
      });
    });

    card.addEventListener('click', (event) => {
      if (event.target.closest('[data-role-chip], [data-person-role], .person-assign-card__roles')) {
        return;
      }
      if (event.target.closest('.person-assign-card__main')) {
        return;
      }
      event.preventDefault();
      togglePerson();
    });

    checkbox.addEventListener('change', sync);
    if (checkbox.checked) {
      card.dataset.rolesTouched = '1';
    }
    sync();
  });
</script>

<%- include('partials/foot') %>
