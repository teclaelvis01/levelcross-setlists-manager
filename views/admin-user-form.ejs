<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const isEdit = !!(user && user.id);
  const errors = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  const formEmail = user && user.email ? user.email : '';
  const formName = user && user.name ? user.name : '';
  const formAvatar = user && user.avatar_url ? user.avatar_url : '';
  const perms = typeof permissions !== 'undefined' && permissions ? permissions : {};
  const labels = typeof sectionLabels !== 'undefined' && sectionLabels ? sectionLabels : {};
  const sectionList = typeof sections !== 'undefined' && Array.isArray(sections) ? sections : ['songs', 'activities', 'people', 'settings'];
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1><%= isEdit ? 'Editar usuario' : 'Nuevo usuario' %></h1>
    <p class="page-subtitle">Registra un correo y define qué puede ver o editar en el admin</p>
  </div>
  <a href="<%= base %>/admin/ajustes" class="btn btn-secondary">← Volver</a>
</div>

<%- include('partials/admin-nav', { adminSection: 'settings' }) %>

<div class="section-card">
  <form
    action="<%= base %><%= isEdit ? '/admin/ajustes/usuarios/' + user.id : '/admin/ajustes/usuarios' %>"
    method="POST"
    class="song-form"
  >
    <% if (isEdit) { %>
      <div class="user-edit-profile">
        <% if (formAvatar) { %>
          <img class="user-edit-profile__avatar" src="<%= formAvatar %>" alt="" width="64" height="64" referrerpolicy="no-referrer">
        <% } else { %>
          <span class="user-edit-profile__avatar user-edit-profile__avatar--fallback" aria-hidden="true"><%= (formName || formEmail || '?').charAt(0).toUpperCase() %></span>
        <% } %>
        <div class="user-edit-profile__meta">
          <strong><%= formName || formEmail %></strong>
          <% if (formName) { %><p class="help-text"><%= formEmail %></p><% } %>
          <p class="help-text"><%= formAvatar ? 'Foto de perfil de Google (solo lectura).' : 'Aún no ha iniciado sesión con Google; la foto aparecerá después del primer login.' %></p>
        </div>
      </div>
    <% } %>

    <div class="form-group<%= errors.email ? ' is-invalid' : '' %>">
      <label for="email">Correo electrónico *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        value="<%= formEmail %>"
        placeholder="usuario@ejemplo.com"
        autocomplete="email"
        aria-invalid="<%= errors.email ? 'true' : 'false' %>"
      >
      <% if (errors.email) { %><p class="field-error">Revisa el correo</p><% } %>
      <p class="help-text">Deberá iniciar sesión con Google usando exactamente este correo.</p>
    </div>

    <div class="form-group user-perm-block<%= errors.permissions ? ' is-invalid' : '' %>">
      <div class="user-perm-block__header">
        <h3 class="user-perm-block__title">Permisos por sección</h3>
        <p class="help-text">Escritura incluye lectura. Sin permiso, la sección no aparece.</p>
      </div>
      <div class="user-perm-grid">
        <% sectionList.forEach((section) => { %>
          <div class="user-perm-row">
            <span class="user-perm-row__label"><%= labels[section] || section %></span>
            <div class="chip-selector chip-selector--single user-perm-chips" role="radiogroup" aria-label="Permisos de <%= labels[section] || section %>">
              <label class="chip-option">
                <input type="radio" name="perm_<%= section %>" value="" <%= !perms[section] ? 'checked' : '' %>>
                <span>Sin acceso</span>
              </label>
              <label class="chip-option">
                <input type="radio" name="perm_<%= section %>" value="read" <%= perms[section] === 'read' ? 'checked' : '' %>>
                <span>Lectura</span>
              </label>
              <label class="chip-option">
                <input type="radio" name="perm_<%= section %>" value="write" <%= perms[section] === 'write' ? 'checked' : '' %>>
                <span>Escritura</span>
              </label>
            </div>
          </div>
        <% }) %>
      </div>
      <% if (errors.permissions) { %><p class="field-error">Asigna al menos un permiso</p><% } %>
    </div>

    <div class="form-actions">
      <a href="<%= base %>/admin/ajustes" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary"><%= isEdit ? '💾 Guardar' : '✅ Crear usuario' %></button>
    </div>
  </form>
</div>

<% if (isEdit) { %>
  <section class="danger-zone">
    <h2>Zona de peligro</h2>
    <p>El usuario dejará de poder acceder al panel de administración. Esta acción no se puede deshacer.</p>
    <form
      action="<%= base %>/admin/ajustes/usuarios/<%= user.id %>/delete"
      method="POST"
      data-confirm-delete
      data-confirm-name="<%= formEmail %>"
      data-confirm-title="Eliminar usuario"
      data-confirm-message="El usuario dejará de poder acceder al panel de administración. Esta acción no se puede deshacer."
      data-confirm-submit-label="Eliminar usuario"
    >
      <button type="submit" class="btn btn-danger">Eliminar usuario</button>
    </form>
  </section>
  <script src="<%= base %>/confirm-delete.js"></script>
<% } %>

<%- include('partials/foot') %>
