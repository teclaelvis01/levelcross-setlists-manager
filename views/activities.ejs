<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const maxAvatars = 4;
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1>Actividades</h1>
    <p class="page-subtitle">Ensayos, cultos y eventos programados</p>
  </div>
</div>

<%- include('partials/public-nav', { publicSection: 'activities' }) %>

<% if (!activities || activities.length === 0) { %>
  <div class="empty-state">
    <p>No hay actividades programadas todavía.</p>
  </div>
<% } else { %>
  <div class="activity-timeline">
    <% let previousDate = null;
      activities.forEach((activity, index) => {
        const showDateMarker = activity.activity_date !== previousDate;
        previousDate = activity.activity_date;
    %>
      <%- include('partials/activity-timeline-item', {
        activity,
        href: base + '/actividades/' + activity.slug,
        maxAvatars,
        showDateMarker,
        isLast: index === activities.length - 1
      }) %>
    <% }) %>
  </div>
<% } %>

<%- include('partials/foot') %>
