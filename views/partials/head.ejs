<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LevelCross Setlists Manager</title>
  <link rel="stylesheet" href="<%= (typeof baseUrl !== 'undefined' ? baseUrl : '') %>/styles.css">
</head>
<body>
  <header>
    <nav>
      <a href="<%= (typeof baseUrl !== 'undefined' ? baseUrl : '') %>/" class="logo">🎵 Setlists</a>
      <div class="nav-links">
        <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
          <a href="<%= (typeof baseUrl !== 'undefined' ? baseUrl : '') %>/admin" class="nav-link">Admin</a>
          <span class="nav-user">
            <% if (typeof userAvatar !== 'undefined' && userAvatar) { %>
              <img class="nav-user-avatar" src="<%= userAvatar %>" alt="" width="28" height="28" referrerpolicy="no-referrer">
            <% } else { %>
              <span class="nav-user-avatar nav-user-avatar--fallback" aria-hidden="true"><%= ((typeof userName !== 'undefined' && userName) ? userName : (userEmail || '?')).charAt(0).toUpperCase() %></span>
            <% } %>
            <span class="nav-user-label"><%= (typeof userName !== 'undefined' && userName) ? userName : userEmail %></span>
          </span>
          <a href="<%= (typeof baseUrl !== 'undefined' ? baseUrl : '') %>/logout" class="btn btn-secondary btn-sm">Salir</a>
        <% } %>
      </div>
    </nav>
  </header>
  <main>
