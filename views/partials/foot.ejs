</main>
  <footer>
    <p>LevelCross Setlists</p>
  </footer>

  <% if (typeof flash !== 'undefined' && flash && flash.message) { %>
    <div
      class="app-toast app-toast--<%= flash.type || 'info' %><%= flash.sticky ? ' app-toast--sticky' : '' %>"
      data-app-toast
      data-toast-sticky="<%= flash.sticky ? '1' : '0' %>"
      role="alert"
      aria-live="assertive"
    >
      <div class="app-toast__icon" aria-hidden="true">
        <%= flash.type === 'success' ? '✓' : (flash.type === 'error' ? '!' : 'i') %>
      </div>
      <div class="app-toast__body">
        <% if (flash.title) { %>
          <strong class="app-toast__title"><%= flash.title %></strong>
        <% } %>
        <p class="app-toast__message"><%= flash.message %></p>
      </div>
      <button type="button" class="app-toast__close" data-app-toast-close aria-label="Cerrar">×</button>
    </div>
  <% } %>

  <script>
    (function () {
      function closeToast(toast) {
        if (!toast) return;
        toast.classList.add('is-leaving');
        window.setTimeout(function () {
          toast.remove();
        }, 180);
      }

      function bindToast(toast) {
        var closeBtn = toast.querySelector('[data-app-toast-close]');
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            closeToast(toast);
          });
        }

        var sticky = toast.getAttribute('data-toast-sticky') === '1' || toast.classList.contains('app-toast--sticky');
        if (sticky) return;

        var delay = toast.classList.contains('app-toast--error') ? 0 : 7000;
        if (delay > 0) {
          window.setTimeout(function () {
            closeToast(toast);
          }, delay);
        }
      }

      document.querySelectorAll('[data-app-toast]').forEach(bindToast);

      window.showAppToast = function (message, type, options) {
        options = options || {};
        var existing = document.querySelector('[data-app-toast]');
        if (existing) existing.remove();

        var toast = document.createElement('div');
        var sticky = !!options.sticky;
        toast.className = 'app-toast app-toast--' + (type || 'info') + (sticky ? ' app-toast--sticky' : '');
        toast.setAttribute('data-app-toast', '');
        toast.setAttribute('data-toast-sticky', sticky ? '1' : '0');
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');

        var icon = type === 'success' ? '✓' : (type === 'error' ? '!' : 'i');
        toast.innerHTML =
          '<div class="app-toast__icon" aria-hidden="true">' + icon + '</div>' +
          '<div class="app-toast__body">' +
            (options.title ? '<strong class="app-toast__title"></strong>' : '') +
            '<p class="app-toast__message"></p>' +
          '</div>' +
          '<button type="button" class="app-toast__close" data-app-toast-close aria-label="Cerrar">×</button>';

        if (options.title) {
          toast.querySelector('.app-toast__title').textContent = options.title;
        }
        toast.querySelector('.app-toast__message').textContent = message;
        document.body.appendChild(toast);
        bindToast(toast);
      };
    })();
  </script>
</body>
</html>
