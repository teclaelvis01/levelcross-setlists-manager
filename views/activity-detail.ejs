<%- include('partials/head') %>

<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const returnPath = base + '/actividades/' + activity.slug;
  const peopleCount = people ? people.length : 0;
  const songsCount = songs ? songs.length : 0;
%>

<%- include('partials/public-nav', { publicSection: 'activities' }) %>

<div class="viewer activity-detail">
  <div class="viewer__header">
    <div class="viewer__info">
      <h1><%= activity.name %></h1>
      <div class="activity-meta">
        <span><%= activity.activity_date %></span>
        <% if (activity.activity_time) { %>
          <span class="activity-meta__sep">·</span>
          <span><%= activity.activity_time %>h</span>
        <% } %>
      </div>
    </div>
    <div class="viewer__actions">
      <a href="<%= base %>/actividades" class="btn btn-secondary">← Volver</a>
    </div>
  </div>

  <% if (activity.detail) { %>
    <p class="activity-detail__note"><%= activity.detail %></p>
  <% } %>

  <section class="activity-people" data-list-filter data-list-filter-total="<%= peopleCount %>">
    <div class="activity-setlist__header">
      <h2>Personas</h2>
      <span class="activity-setlist__count" data-list-filter-count><%= peopleCount %></span>
    </div>

    <% if (peopleCount > 0) { %>
      <div class="search-bar search-bar--compact search-bar--full">
        <input
          type="search"
          data-list-filter-input
          placeholder="Escribe al menos 3 caracteres para buscar..."
          autocomplete="off"
        >
      </div>

      <div class="activity-people-chips" data-list-filter-list>
        <% people.forEach(person => {
          const roles = person.activityRoles || person.roles || [];
          const initial = (person.name || 'P').charAt(0).toUpperCase();
          const roleText = roles.length ? roles.join(' · ') : 'Sin rol';
          const filterText = [person.name].concat(roles).filter(Boolean).join(' ');
        %>
          <div
            class="activity-person-chip"
            title="<%= person.name %> — <%= roleText %>"
            data-list-filter-item
            data-filter-text="<%= filterText %>"
          >
            <% if (person.photo_url) { %>
              <img
                src="<%= photoSrc(person.photo_url) %>"
                alt=""
                class="activity-person-chip__photo"
                referrerpolicy="no-referrer"
              >
            <% } else { %>
              <span class="activity-person-chip__photo activity-person-chip__photo--fallback" aria-hidden="true"><%= initial %></span>
            <% } %>
            <span class="activity-person-chip__text">
              <strong><%= person.name %></strong>
              <small><%= roleText %></small>
            </span>
          </div>
        <% }) %>
      </div>

      <div class="empty-state compact" data-list-filter-empty hidden>
        <p>No hay personas que coincidan con la búsqueda.</p>
      </div>
    <% } else { %>
      <div class="empty-state compact">
        <p>Aún no hay personas asignadas a esta actividad.</p>
      </div>
    <% } %>
  </section>

  <section class="activity-setlist" data-list-filter data-list-filter-total="<%= songsCount %>">
    <div class="activity-setlist__header">
      <h2>Canciones</h2>
      <span class="activity-setlist__count" data-list-filter-count><%= songsCount %></span>
    </div>

    <% if (songsCount > 0) { %>
      <div class="search-bar search-bar--compact search-bar--full">
        <input
          type="search"
          data-list-filter-input
          placeholder="Escribe al menos 3 caracteres para buscar..."
          autocomplete="off"
        >
      </div>

      <ol class="activity-setlist__list" data-list-filter-list>
        <% songs.forEach((song, index) => {
          const filterText = [song.title, song.artist].filter(Boolean).join(' ');
        %>
          <li data-list-filter-item data-filter-text="<%= filterText %>">
            <a
              class="activity-setlist__item"
              href="<%= base %>/songs/<%= song.slug %>?from=<%= encodeURIComponent(returnPath) %>"
            >
              <span class="activity-setlist__pos"><%= index + 1 %></span>
              <span class="activity-setlist__info">
                <strong><%= song.title %></strong>
                <% if (song.artist) { %>
                  <small><%= song.artist %></small>
                <% } %>
              </span>
              <span class="activity-setlist__chevron" aria-hidden="true">›</span>
            </a>
          </li>
        <% }) %>
      </ol>

      <div class="empty-state compact" data-list-filter-empty hidden>
        <p>No hay canciones que coincidan con la búsqueda.</p>
      </div>
    <% } else { %>
      <div class="empty-state compact">
        <p>Aún no hay canciones asignadas a esta actividad.</p>
      </div>
    <% } %>
  </section>
</div>

<script src="<%= base %>/list-filter.js"></script>
<%- include('partials/foot') %>
