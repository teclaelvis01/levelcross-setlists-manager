<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const isEdit = !!(person && person.id);
  const errors = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  const selectedRoles = person && Array.isArray(person.roles) ? person.roles : [];
  const currentPhoto = person && person.photo_url ? photoSrc(person.photo_url) : '';
  const formName = person && person.name ? person.name : '';
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1><%= isEdit ? 'Editar persona' : 'Nueva persona' %></h1>
    <p class="page-subtitle">Define el nombre, la foto y los roles musicales</p>
  </div>
  <a href="<%= base %>/admin/personas" class="btn btn-secondary">← Volver</a>
</div>

<%- include('partials/admin-nav', { adminSection: 'people' }) %>

<div class="section-card">
  <form
    action="<%= base %><%= isEdit ? '/admin/personas/' + person.id : '/admin/personas' %>"
    method="POST"
    class="song-form"
    enctype="multipart/form-data"
  >
    <div class="form-group<%= errors.name ? ' is-invalid' : '' %>">
      <label for="name">Nombre *</label>
      <input type="text" id="name" name="name" required value="<%= formName %>" placeholder="Ej: Camilo Pérez" aria-invalid="<%= errors.name ? 'true' : 'false' %>">
      <% if (errors.name) { %><p class="field-error">El nombre es obligatorio</p><% } %>
    </div>

    <div class="form-group<%= errors.photo ? ' is-invalid' : '' %>">
      <label>Foto</label>
      <p class="help-text">Elige una imagen y recórtala a 150×150. Máximo 1 MB.</p>

      <div class="photo-upload" data-photo-upload<%= currentPhoto ? ' data-has-photo' : '' %>>
        <button type="button" class="photo-upload__preview" data-photo-trigger aria-label="Elegir foto">
          <span data-photo-preview>
            <% if (currentPhoto) { %>
              <img src="<%= currentPhoto %>" alt="<%= formName %>" class="photo-upload__img" referrerpolicy="no-referrer">
            <% } else { %>
              <span class="photo-upload__placeholder" aria-hidden="true">+</span>
            <% } %>
          </span>
        </button>

        <div class="photo-upload__controls">
          <input
            type="file"
            id="photo"
            name="photo"
            class="photo-upload__input"
            accept="image/jpeg,image/png,image/webp,image/gif"
            data-photo-input
          >
          <input type="hidden" name="kept_photo_url" value="<%= person && person.photo_url ? person.photo_url : '' %>" data-kept-photo>
          <input type="hidden" name="remove_photo" value="0" data-photo-remove>

          <div class="photo-upload__actions">
            <button type="button" class="btn btn-secondary btn-sm" data-photo-trigger>
              <span data-photo-trigger-label><%= currentPhoto ? 'Cambiar foto' : 'Elegir foto' %></span>
            </button>
            <button type="button" class="btn btn-danger btn-sm<%= currentPhoto ? '' : ' is-hidden' %>" data-photo-clear>
              Quitar
            </button>
          </div>
          <p class="photo-upload__filename" data-photo-filename></p>
        </div>
      </div>
      <% if (errors.photo) { %><p class="field-error">Revisa la imagen seleccionada</p><% } %>
    </div>

    <div class="form-group<%= errors.roles ? ' is-invalid' : '' %>">
      <label>Roles *</label>
      <p class="help-text">Selecciona todos los roles que esta persona puede desempeñar.</p>
      <div class="chip-selector<%= errors.roles ? ' is-invalid' : '' %>">
        <% if (!roles || roles.length === 0) { %>
          <p class="help-text">No hay roles configurados. Créalos en <a href="<%= base %>/admin/ajustes">Ajustes</a>.</p>
        <% } else { %>
          <% roles.forEach(role => { %>
            <label class="chip-option">
              <input type="checkbox" name="roles" value="<%= role %>" <%= selectedRoles.includes(role) ? 'checked' : '' %>>
              <span><%= role %></span>
            </label>
          <% }) %>
        <% } %>
      </div>
      <% if (errors.roles) { %><p class="field-error">Selecciona al menos un rol</p><% } %>
    </div>

    <div class="form-actions">
      <a href="<%= base %>/admin/personas" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary"><%= isEdit ? '💾 Guardar' : '✅ Crear' %></button>
    </div>
  </form>
</div>

<% if (isEdit) { %>
  <section class="danger-zone">
    <h2>Zona de peligro</h2>
    <p>La persona dejará de aparecer en el listado y no se podrá asignar a actividades nuevas, pero seguirá visible en las actividades donde ya participó.</p>
    <form
      action="<%= base %>/admin/personas/<%= person.id %>/delete"
      method="POST"
      onsubmit="return confirm(<%= JSON.stringify('¿Eliminar a ' + person.name + '? Seguirá visible en actividades pasadas.') %>)"
    >
      <button type="submit" class="btn btn-danger">Eliminar persona</button>
    </form>
  </section>
<% } %>

<div class="photo-crop-modal" data-photo-crop-modal hidden>
  <div class="photo-crop-modal__backdrop" data-crop-backdrop></div>
  <div class="photo-crop-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="photo-crop-title">
    <div class="photo-crop-modal__header">
      <h2 id="photo-crop-title">Recortar foto</h2>
      <p>Arrastra para encuadrar y usa el zoom. Se guardará a 150×150.</p>
    </div>

    <div class="photo-crop-stage">
      <div class="photo-crop-viewport">
        <img alt="" draggable="false" data-crop-image class="photo-crop-image">
      </div>
    </div>

    <label class="photo-crop-zoom">
      <span>Zoom</span>
      <input type="range" min="1" max="3" step="0.01" value="1" data-crop-zoom>
    </label>

    <div class="photo-crop-modal__actions">
      <button type="button" class="btn btn-secondary" data-crop-cancel>Cancelar</button>
      <button type="button" class="btn btn-primary" data-crop-apply>Usar foto</button>
    </div>
  </div>
</div>

<script src="<%= base %>/photo-crop.js"></script>

<%- include('partials/foot') %>
