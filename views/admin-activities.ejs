<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const safeActivities = typeof activities !== 'undefined' ? activities : [];
  const maxAvatars = 4;
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1>Actividades</h1>
    <p class="page-subtitle">Crea y gestiona ensayos, cultos y eventos</p>
  </div>
  <div class="header-actions">
    <% if (typeof canAccess === 'function' && canAccess('activities', 'write')) { %>
      <a href="<%= base %>/admin/actividades/nueva" class="btn btn-primary">+ Nueva actividad</a>
    <% } %>
  </div>
</div>

<%- include('partials/admin-nav', { adminSection: 'activities' }) %>

<% if (safeActivities.length === 0) { %>
  <div class="empty-state">
    <p>No hay actividades creadas aún</p>
    <% if (typeof canAccess === 'function' && canAccess('activities', 'write')) { %>
      <a href="<%= base %>/admin/actividades/nueva" class="btn btn-primary">+ Crear primera actividad</a>
    <% } %>
  </div>
<% } else { %>
  <div class="activity-timeline">
    <% let previousDate = null;
      safeActivities.forEach((activity, index) => {
        const showDateMarker = activity.activity_date !== previousDate;
        previousDate = activity.activity_date;
    %>
      <%- include('partials/activity-timeline-item', {
        activity,
        href: (typeof canAccess === 'function' && canAccess('activities', 'write'))
          ? (base + '/admin/actividades/' + activity.id + '/editar')
          : (base + '/actividades/' + (activity.slug || activity.id)),
        maxAvatars,
        showDateMarker,
        isLast: index === safeActivities.length - 1
      }) %>
    <% }) %>
  </div>
<% } %>

<%- include('partials/foot') %>
