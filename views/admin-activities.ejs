<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const safeActivities = typeof activities !== 'undefined' ? activities : [];
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1>Actividades</h1>
    <p class="page-subtitle">Crea y gestiona ensayos, cultos y eventos</p>
  </div>
  <div class="header-actions">
    <a href="<%= base %>/admin/actividades/nueva" class="btn btn-primary">+ Nueva actividad</a>
  </div>
</div>

<%- include('partials/admin-nav', { adminSection: 'activities' }) %>

<% if (safeActivities.length === 0) { %>
  <div class="empty-state">
    <p>No hay actividades creadas aún</p>
    <a href="<%= base %>/admin/actividades/nueva" class="btn btn-primary">+ Crear primera actividad</a>
  </div>
<% } else { %>
  <div class="activity-list admin-list">
    <% safeActivities.forEach(activity => { %>
      <a href="<%= base %>/admin/actividades/<%= activity.id %>/editar" class="activity-card admin-entity-card activity-card--link">
        <div class="activity-card__body">
          <h3 class="admin-entity-card__title"><%= activity.name %></h3>
          <div class="activity-card__meta">
            <span><%= activity.activity_date %></span>
            <% if (activity.activity_time) { %>
              <span>· <%= activity.activity_time %></span>
            <% } %>
          </div>
          <% if (activity.detail) { %>
            <p class="activity-card__detail"><%= activity.detail.length > 120 ? activity.detail.slice(0, 120) + '...' : activity.detail %></p>
          <% } %>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/foot') %>
