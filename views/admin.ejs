<% 
  const safeSongs = typeof songs !== 'undefined' ? songs : [];
  const safeSearch = typeof search !== 'undefined' ? search : '';
  const safePageSize = typeof pageSize !== 'undefined' ? pageSize : 12;
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1>Canciones</h1>
    <p class="page-subtitle">Biblioteca de canciones del ministerio</p>
  </div>
  <div class="header-actions">
    <a href="<%= base %>/admin/songs/new" class="btn btn-primary">+ Nueva canción</a>
  </div>
</div>

<%- include('partials/admin-nav', { adminSection: 'songs' }) %>

<div class="search-bar">
  <form action="<%= base %>/admin" method="GET">
    <input type="text" name="search" placeholder="Buscar canción..." value="<%= safeSearch %>">
    <input type="hidden" name="page" value="1">
    <input type="hidden" name="pageSize" value="<%= safePageSize %>">
    <button type="submit" class="btn">🔍 Buscar</button>
  </form>
</div>

<% if (safeSongs.length === 0) { %>
  <div class="empty-state">
    <p><%= safeSearch ? 'No hay resultados para esa búsqueda' : 'No hay canciones aún' %></p>
    <% if (!safeSearch) { %>
      <a href="<%= base %>/admin/songs/new" class="btn btn-primary">+ Crear primera canción</a>
    <% } %>
  </div>
<% } else { %>
  <div class="results-meta">
    <p>Mostrando <%= safeSongs.length %> de <%= totalCount %> canciones</p>
  </div>

  <div class="song-list admin-list">
    <% safeSongs.forEach(song => { %>
      <div class="song-card">
        <a href="<%= base %>/songs/<%= song.slug %>" class="song-card__link">
          <div class="song-card__info">
            <h3><%= song.title %></h3>
            <% if (song.artist) { %>
              <p class="song-card__artist"><%= song.artist %></p>
            <% } %>
          </div>
        </a>
        <div class="song-card__actions">
          <% if (song.audio_url) { %>
            <a href="<%= song.audio_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-icon" title="Escuchar">🔊</a>
          <% } %>
          <a href="<%= base %>/admin/songs/<%= song.slug %>/edit" class="btn btn-icon" title="Editar">✏️</a>
          <form action="<%= base %>/admin/songs/<%= song.slug %>/delete" method="POST" class="inline-form" onsubmit="return confirm('¿Eliminar esta canción?')">
            <button type="submit" class="btn btn-icon btn-danger" title="Eliminar">🗑️</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <div class="pagination">
      <a href="<%= base %>/admin?search=<%= encodeURIComponent(search) %>&page=<%= currentPage - 1 %>&pageSize=<%= pageSize %>" class="btn btn-secondary <%= hasPrev ? '' : 'is-disabled' %>">← Anterior</a>
      <div class="pagination__pages">
        <% for (let pageNumber = Math.max(1, currentPage - 1); pageNumber <= Math.min(totalPages, currentPage + 1); pageNumber++) { %>
          <a href="<%= base %>/admin?search=<%= encodeURIComponent(search) %>&page=<%= pageNumber %>&pageSize=<%= pageSize %>" class="pagination__page <%= pageNumber === currentPage ? 'is-active' : '' %>"><%= pageNumber %></a>
        <% } %>
      </div>
      <a href="<%= base %>/admin?search=<%= encodeURIComponent(search) %>&page=<%= currentPage + 1 %>&pageSize=<%= pageSize %>" class="btn btn-secondary <%= hasNext ? '' : 'is-disabled' %>">Siguiente →</a>
      <select class="page-size-select" onchange="window.location.href='<%= base %>/admin?search=<%= encodeURIComponent(search) %>&page=1&pageSize=' + this.value">
        <option value="5" <%= pageSize === 5 ? 'selected' : '' %>>5 por página</option>
        <option value="10" <%= pageSize === 10 ? 'selected' : '' %>>10 por página</option>
        <option value="50" <%= pageSize === 50 ? 'selected' : '' %>>50 por página</option>
      </select>
    </div>
  <% } %>
<% } %>

<details class="admin-backup">
  <summary>Backup de base de datos</summary>
  <p class="backup-desc">Exporta o importa la base de datos SQLite completa.</p>
  <div class="backup-actions">
    <a href="<%= base %>/admin/export" class="btn btn-primary">⬇️ Exportar DB</a>
    <form action="<%= base %>/admin/import" method="POST" enctype="multipart/form-data" class="inline-form">
      <label class="btn btn-secondary import-label">
        📤 Importar DB
        <input type="file" name="database" accept=".db,.sqlite,.sqlite3" required hidden onchange="this.form.submit()">
      </label>
    </form>
  </div>
</details>

<%- include('partials/foot') %>
