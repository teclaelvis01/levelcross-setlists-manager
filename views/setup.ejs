<%
  const values = typeof formValues !== 'undefined' && formValues ? formValues : { email: '', token: '' };
  const errors = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
%>

<%- include('partials/head') %>

<div class="auth-container">
  <div class="auth-card">
    <h1>Configuración inicial</h1>
    <p class="auth-desc">Define el correo del administrador. Después podrás iniciar sesión con Google usando ese mismo correo.</p>

    <form action="<%= (typeof baseUrl !== 'undefined' ? baseUrl : '') %>/setup" method="POST" class="auth-form">
      <input type="hidden" name="token" value="<%= values.token || '' %>">
      <div class="form-group<%= errors.email ? ' is-invalid' : '' %>">
        <label for="email">Correo del administrador</label>
        <input type="email" id="email" name="email" required placeholder="admin@ejemplo.com" autocomplete="email" value="<%= values.email || '' %>" aria-invalid="<%= errors.email ? 'true' : 'false' %>">
        <% if (errors.email) { %><p class="field-error">Introduce un correo válido</p><% } %>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Guardar y continuar</button>
    </form>
  </div>
</div>

<%- include('partials/foot') %>
