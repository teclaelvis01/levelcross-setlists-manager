<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const safeRoles = typeof roles !== 'undefined' ? roles : [];
  const mediaCount = typeof multimediaCount !== 'undefined' ? multimediaCount : 0;
  const rolesOpen = safeRoles.length === 0;
  const pageFlash = typeof flash !== 'undefined' && flash ? flash : null;
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1>Ajustes</h1>
    <p class="page-subtitle">Roles, copias de seguridad y multimedia</p>
  </div>
</div>

<%- include('partials/admin-nav', { adminSection: 'settings' }) %>

<% if (pageFlash && pageFlash.message) { %>
  <div class="settings-flash settings-flash--<%= pageFlash.type || 'info' %>" role="status">
    <div class="settings-flash__icon" aria-hidden="true">
      <%= pageFlash.type === 'success' ? '✓' : (pageFlash.type === 'error' ? '!' : 'i') %>
    </div>
    <div class="settings-flash__body">
      <% if (pageFlash.title) { %>
        <strong><%= pageFlash.title %></strong>
      <% } %>
      <p><%= pageFlash.message %></p>
    </div>
  </div>
<% } %>

<details class="settings-panel"<%= rolesOpen ? ' open' : '' %>>
  <summary class="settings-panel__summary">
    <div class="settings-panel__heading">
      <h2>Roles musicales</h2>
      <p class="help-text">Usados al crear personas y asignarlas a actividades.</p>
    </div>
    <span class="settings-panel__badge"><%= safeRoles.length %></span>
  </summary>

  <div class="settings-panel__body">
    <% if (safeRoles.length === 0) { %>
      <div class="empty-state compact">
        <p>No hay roles creados aún</p>
        <a href="<%= base %>/admin/ajustes/roles/nuevo" class="btn btn-primary">+ Crear primer rol</a>
      </div>
    <% } else { %>
      <div class="role-chip-list">
        <% safeRoles.forEach(roleItem => { %>
          <a href="<%= base %>/admin/ajustes/roles/<%= roleItem.id %>/editar" class="role-chip">
            <span class="role-chip__name"><%= roleItem.name %></span>
            <% if (roleItem.category) { %>
              <span class="role-chip__meta"><%= roleItem.category %></span>
            <% } %>
          </a>
        <% }) %>
        <a href="<%= base %>/admin/ajustes/roles/nuevo" class="role-chip role-chip--add">+ Nuevo</a>
      </div>
    <% } %>
  </div>
</details>

<section class="section-card settings-backup">
  <h2>Backup de base de datos</h2>
  <p class="help-text">Exporta o importa la base de datos SQLite completa (canciones, personas, actividades y usuarios).</p>
  <div class="backup-actions">
    <a href="<%= base %>/admin/export" class="btn btn-primary">⬇️ Exportar DB</a>
    <form action="<%= base %>/admin/import" method="POST" enctype="multipart/form-data" class="inline-form" data-backup-import data-backup-label="Importando base de datos…">
      <label class="btn btn-secondary import-label" data-import-label>
        📤 Importar DB
        <input type="file" name="database" accept=".db,.sqlite,.sqlite3" required hidden data-backup-file>
      </label>
    </form>
  </div>
</section>

<section class="section-card settings-backup">
  <h2>Multimedia</h2>
  <p class="help-text">
    Exporta o importa las fotos de personas y otros archivos subidos.
    <% if (mediaCount > 0) { %>
      Actualmente hay <%= mediaCount %> archivo<%= mediaCount === 1 ? '' : 's' %>.
    <% } else { %>
      No hay archivos multimedia todavía.
    <% } %>
  </p>
  <div class="backup-actions">
    <a href="<%= base %>/admin/ajustes/multimedia/export" class="btn btn-primary<%= mediaCount === 0 ? ' is-disabled' : '' %>"<%= mediaCount === 0 ? ' aria-disabled="true" tabindex="-1"' : '' %>>⬇️ Exportar multimedia</a>
    <form action="<%= base %>/admin/ajustes/multimedia/import" method="POST" enctype="multipart/form-data" class="inline-form" data-backup-import data-backup-label="Importando multimedia…">
      <label class="btn btn-secondary import-label" data-import-label>
        📤 Importar multimedia
        <input type="file" name="multimedia" accept=".zip,application/zip" required hidden data-backup-file>
      </label>
    </form>
  </div>
</section>

<div class="backup-busy" data-backup-busy hidden>
  <div class="backup-busy__card" role="status" aria-live="polite">
    <div class="backup-busy__spinner" aria-hidden="true"></div>
    <strong data-backup-busy-title>Importando…</strong>
    <p>No cierres esta página hasta que termine.</p>
  </div>
</div>

<script>
  (function () {
    var busy = document.querySelector('[data-backup-busy]');
    var busyTitle = document.querySelector('[data-backup-busy-title]');

    document.querySelectorAll('[data-backup-import]').forEach(function (form) {
      var input = form.querySelector('[data-backup-file]');
      if (!input) return;

      input.addEventListener('change', function () {
        if (!input.files || !input.files.length) return;
        if (busy) {
          busy.hidden = false;
          if (busyTitle) busyTitle.textContent = form.getAttribute('data-backup-label') || 'Importando…';
        }
        form.requestSubmit();
      });
    });
  })();
</script>

<%- include('partials/foot') %>
