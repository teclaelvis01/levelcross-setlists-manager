<%- include('partials/head') %>

<div class="auth-container">
  <div class="auth-card">
    <h1>Iniciar sesión</h1>
    <p class="auth-desc">Accede al panel de administración con tu cuenta de Google.</p>

    <% if (typeof googleConfigured !== 'undefined' && googleConfigured) { %>
      <a href="<%= (typeof baseUrl !== 'undefined' ? baseUrl : '') %>/auth/google" class="btn btn-google btn-full">
        <span class="btn-google-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4"/>
            <path d="M9 18c2.43 0 4.467-.806 5.96-2.184l-2.908-2.258c-.806.54-1.837.86-3.052.86-2.347 0-4.335-1.584-5.043-3.71H.957v2.332C2.438 15.983 5.482 18 9 18z" fill="#34A853"/>
            <path d="M3.957 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.348 6.173 0 7.548 0 9s.348 2.827.957 4.042l3-2.332z" fill="#FBBC05"/>
            <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.957 7.29C4.665 5.163 6.653 3.58 9 3.58z" fill="#EA4335"/>
          </svg>
        </span>
        Continuar con Google
      </a>
    <% } else { %>
      <p class="auth-warning">Google OAuth no está configurado. Define <code>GOOGLE_CLIENT_ID</code>, <code>GOOGLE_CLIENT_SECRET</code> y <code>APP_URL</code>.</p>
    <% } %>
  </div>
</div>

<%- include('partials/foot') %>
