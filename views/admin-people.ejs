<%
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '';
  const safeSearch = typeof search !== 'undefined' ? search : '';
  const safeTotalCount = typeof totalCount !== 'undefined' ? totalCount : (people ? people.length : 0);
%>

<%- include('partials/head') %>

<div class="page-header">
  <div>
    <h1>Personas</h1>
    <p class="page-subtitle">Músicos y roles disponibles para las actividades</p>
  </div>
  <div class="header-actions">
    <a href="<%= base %>/admin/personas/nueva" class="btn btn-primary">+ Nueva persona</a>
  </div>
</div>

<%- include('partials/admin-nav', { adminSection: 'people' }) %>

<div class="search-bar">
  <form
    data-live-search
    data-live-search-results="#people-search-results"
    action="<%= base %>/admin/personas"
    method="GET"
  >
    <input
      type="search"
      data-live-search-input
      name="search"
      placeholder="Escribe al menos 3 caracteres para buscar..."
      value="<%= safeSearch %>"
      autocomplete="off"
    >
  </form>
</div>

<div id="people-search-results" data-live-search-results>
<% if (!people || people.length === 0) { %>
  <div class="empty-state">
    <p><%= safeSearch ? 'No hay resultados para esa búsqueda' : 'No hay personas creadas aún' %></p>
    <% if (!safeSearch) { %>
      <a href="<%= base %>/admin/personas/nueva" class="btn btn-primary">+ Crear primera persona</a>
    <% } %>
  </div>
<% } else { %>
  <div class="results-meta">
    <p>
      <% if (safeSearch) { %>
        Mostrando <%= people.length %> de <%= safeTotalCount %> persona<%= safeTotalCount === 1 ? '' : 's' %>
      <% } else { %>
        <%= safeTotalCount %> persona<%= safeTotalCount === 1 ? '' : 's' %>
      <% } %>
    </p>
  </div>

  <div class="person-list admin-list">
    <% people.forEach(personItem => { %>
      <a href="<%= base %>/admin/personas/<%= personItem.id %>/editar" class="person-card admin-entity-card person-card--link">
        <div class="person-card__content">
          <% if (personItem.photo_url) { %>
            <img src="<%= photoSrc(personItem.photo_url) %>" alt="<%= personItem.name %>" class="person-photo" referrerpolicy="no-referrer">
          <% } else { %>
            <span class="person-avatar person-avatar--fallback person-photo-fallback"><%= (personItem.name || 'P').charAt(0).toUpperCase() %></span>
          <% } %>
          <div>
            <h3 class="admin-entity-card__title"><%= personItem.name %></h3>
            <div class="chip-list">
              <% (personItem.roles || []).forEach(role => { %>
                <span class="chip"><%= role %></span>
              <% }) %>
            </div>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>
</div>

<script src="<%= base %>/live-search.js"></script>
<%- include('partials/foot') %>
