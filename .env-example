# Copy to .env and fill in real values:
#   cp .env-example .env

NODE_ENV=development
PORT=3000

# Public origin without subpath (used for Google OAuth redirect URI)
# Local:  http://localhost:3000
# Coolify: https://your-domain.com
APP_URL=http://localhost:3000

# Optional path prefix when deployed under a subdirectory (e.g. /setlist-2026)
BASE_URL=

# Strong random string in production
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_SECURE=false

# Google OAuth (Web application client)
# Redirect URI to register in Google Cloud Console:
#   {APP_URL}{BASE_URL}/auth/google/callback
# Example local: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
